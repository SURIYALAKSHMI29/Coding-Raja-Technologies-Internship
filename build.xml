<?xml version="1.0" encoding="UTF-8"?>
<project name="Library_Management" default="run" basedir=".">
    <description>Builds, tests, and runs the Library Management project.</description>

    <!-- Directory properties -->
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="lib.dir" value="lib"/>

    <!-- Path for compile classpath (includes MySQL driver) -->
    <path id="compile.classpath">
        <fileset dir="${lib.dir}">
            <include name="mysql-connector-j-8.2.0.jar"/>
        </fileset>
    </path>

    <!-- Create build directory -->
    <target name="-pre-compile">
        <mkdir dir="${build.dir}"/>
    </target>

    <!-- Compile the Java source files -->
    <target name="compile" depends="-pre-compile">
        <javac srcdir="${src.dir}" destdir="${build.dir}" classpathref="compile.classpath" includeantruntime="false">
            <include name="**/*.java"/>
        </javac>
    </target>

    <!-- Run the project -->
    <target name="run" depends="compile">
        <echo message="Running with classpath:"/>
        <pathconvert pathsep=";" property="runtime.classpath">
            <path>
                <path refid="compile.classpath"/>
                <pathelement path="${build.dir}"/>
            </path>
        </pathconvert>
        <echo message="${runtime.classpath}"/>

        <java classname="library_management.Library_Management" fork="true">
            <classpath>
                <path refid="compile.classpath"/>
                <pathelement path="${build.dir}"/>
            </classpath>
        </java>
    </target>

</project>
